{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/components/ui/button.tsx", "src/components/reui/frame.tsx"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["buttonVariants", "frameVariants"] }]
      }
    }
  ]
}
